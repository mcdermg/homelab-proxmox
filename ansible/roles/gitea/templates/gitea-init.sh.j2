#!/bin/bash
# Log to a file, not the console: nothing reads a headless container's console, so once its buffer fills
# any write blocks (seen with etckeeper's git commit after apt)
exec >>/var/log/99custom-gitea-init.log 2>&1
# Wait for PostgreSQL
until timeout 1 bash -c "</dev/tcp/{{ postgres_ip }}/5432" 2>/dev/null; do
  echo "Waiting for PostgreSQL..."
  sleep 2
done
# Only modify app.ini if still using MySQL
if grep -q "DB_TYPE.*=.*mysql" /home/git/custom/conf/app.ini; then
  systemctl stop gitea
  cp /home/git/custom/conf/app.ini /home/git/custom/conf/app.ini.bak
  sed -i '/^\[database\]/,/^\[/ s/^DB_TYPE.*/DB_TYPE = postgres/' /home/git/custom/conf/app.ini
  sed -i '/^\[database\]/,/^\[/ s/^HOST.*/HOST = {{ postgres_ip }}:5432/' /home/git/custom/conf/app.ini
  sed -i '/^\[database\]/,/^\[/ s/^NAME.*/NAME = gitea/' /home/git/custom/conf/app.ini
  sed -i '/^\[database\]/,/^\[/ s/^USER.*/USER = gitea/' /home/git/custom/conf/app.ini
  sed -i '/^\[database\]/,/^\[/ s/^PASSWD.*/PASSWD = {{ gitea_db_password }}/' /home/git/custom/conf/app.ini
  systemctl start gitea
  sleep 5
fi
# TurnKey's 40gitea inithook sets its admin (named gitea) in the image's bundled MySQL, which the switch to
# PostgreSQL above leaves behind, so the admin is created again in PostgreSQL
if ! su - git -c "cd /home/git && ./gitea admin user list 2>/dev/null" | grep -qw "gitea"; then
  su - git -c "cd /home/git && ./gitea admin user create \
    --username gitea \
    --password {{ gitea_admin_password }} \
    --email {{ gitea_admin_email }} \
    --admin"
fi
# TurnKey also writes ROOT_URL as https+unix://<domain>:3000/, which isn't a URL anyone visits, and the image
# requires email confirmation, which needs mail delivery the lab doesn't have
sed -i 's|^ROOT_URL.*|ROOT_URL = http://{{ gitea_ip }}/|' /etc/gitea/app.ini
sed -i '/^\[service\]/,/^\[/ s/^REGISTER_EMAIL_CONFIRM.*/REGISTER_EMAIL_CONFIRM = false/' /etc/gitea/app.ini
systemctl restart gitea
