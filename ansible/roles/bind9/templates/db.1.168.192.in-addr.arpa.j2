; Reverse zone file for 192.168.1.0/24
; Managed by Ansible - Do not edit manually

$TTL    1h
$ORIGIN 1.168.192.in-addr.arpa.

; Start of Authority
@       IN      SOA     ns1.homelab.local. admin.homelab.local. (
                        {{ bind9_zone_serial | default(ansible_facts['date_time']['epoch']) }}  ; Serial (Unix timestamp)
                        12h                             ; Refresh
                        15m                             ; Retry
                        3w                              ; Expire
                        1h                              ; Negative Cache TTL
                        )

; Name Servers, one per bind9 server (bind9_ips, generated by OpenTofu)
{% for ip in bind9_ips %}
        IN      NS      ns{{ loop.index }}.homelab.local.
{% endfor %}

; PTR Records (reverse DNS lookups)
; Format: last octet IN PTR hostname.homelab.local.

; Proxmox nodes, LXC containers, k3s VMs and Pis (bind9_records, generated by OpenTofu)
{% for name, ip in bind9_records | dictsort if ip.startswith('192.168.1.') %}
{{ '%-7s' | format(ip.split('.')[-1]) }} IN      PTR     {{ name }}.homelab.local.
{% endfor %}
{% for ip in bind9_ips %}
{{ '%-7s' | format(ip.split('.')[-1]) }} IN      PTR     ns{{ loop.index }}.homelab.local.
{% endfor %}

; Kubernetes Services
11      IN      PTR     k8status.homelab.local.
12      IN      PTR     nginx.homelab.local.
13      IN      PTR     argocd.homelab.local.
14      IN      PTR     grafana.homelab.local.
15      IN      PTR     prometheus.homelab.local.
16      IN      PTR     alertmanager.homelab.local.
