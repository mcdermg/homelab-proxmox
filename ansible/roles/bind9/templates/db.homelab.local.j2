; Forward zone file for homelab.local
; Managed by Ansible - Do not edit manually

$TTL    1h
$ORIGIN homelab.local.

; Start of Authority RR defining the key characteristics of the zone
@       IN      SOA     ns1.homelab.local. admin.homelab.local. (
                        {{ bind9_zone_serial | default(ansible_facts['date_time']['epoch']) }}  ; Serial (Unix timestamp)
                        12h                             ; Refresh
                        15m                             ; Retry
                        3w                              ; Expire
                        1h                              ; Negative Cache TTL
                        )

; Name Servers, one per bind9 server (bind9_ips, generated by OpenTofu)
{% for ip in bind9_ips %}
        IN      NS      ns{{ loop.index }}.homelab.local.
{% endfor %}
{% for ip in bind9_ips %}
ns{{ loop.index }}     IN      A       {{ ip }}
{% endfor %}

; Proxmox nodes, LXC containers, k3s VMs and Pis (bind9_records, generated by OpenTofu)
{% for name, ip in bind9_records | dictsort %}
{{ '%-20s' | format(name) }} IN  A       {{ ip }}
{% endfor %}

; Kubernetes Services (MetalLB LoadBalancer IPs, set in homelab-argocd-config)
k8status IN     A       192.168.1.11
nginx   IN      A       192.168.1.12
argocd  IN      A       192.168.1.13
grafana IN      A       192.168.1.14
prometheus IN   A       192.168.1.15
alertmanager IN A       192.168.1.16

; Aliases
dns     IN      CNAME   ns1.homelab.local.
git     IN      CNAME   gitea.homelab.local.
db      IN      CNAME   postgres.homelab.local.
