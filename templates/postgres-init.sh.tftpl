#!/bin/bash
# Create Gitea database and user
su - postgres -c "psql -c \"CREATE DATABASE gitea;\""
su - postgres -c "psql -c \"CREATE USER gitea WITH PASSWORD '${gitea_db_password}';\""
su - postgres -c "psql -c \"GRANT ALL PRIVILEGES ON DATABASE gitea TO gitea;\""
# PostgreSQL 15+ no longer lets PUBLIC create in the public schema; the database owner can
su - postgres -c "psql -c \"ALTER DATABASE gitea OWNER TO gitea;\""
# Configure remote access (REQUIRED for Gitea to connect)
echo "host    gitea    gitea    ${gitea_ip}/32    scram-sha-256" >> /etc/postgresql/*/main/pg_hba.conf
sed -i "s/#listen_addresses = 'localhost'/listen_addresses = '${postgres_ip}'/" /etc/postgresql/*/main/postgresql.conf
systemctl restart postgresql
