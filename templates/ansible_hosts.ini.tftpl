# This is an auto generated file, please use Terraform and do not make manual changes

[proxmox]
${proxmox_node} ansible_host=${proxmox_host}

[proxmox:vars]
ansible_user=${proxmox_ssh_user}
ansible_port=${proxmox_ssh_port}
pm_api_host=${proxmox_host}
pm_api_token_id=${proxmox_api_token_id}
pm_api_token_secret=${proxmox_api_token_secret}
pm_node=${proxmox_node}

# Shared variables available to all hosts
[all:vars]
# Container IDs for pct operations
postgres_ctid=${postgres_ctid}
postgres_ip=${postgres_ip}

gitea_ctid=${gitea_ctid}
gitea_ip=${gitea_ip}

bind9_ctid=${bind9_ctid}
bind9_ip=${bind9_ip}

cloudflared_ctid=${cloudflared_ctid}
cloudflared_ip=${cloudflared_ip}

# Cloudflare Tunnel
cloudflare_tunnel_id=${cloudflare_tunnel_id}
cloudflare_tunnel_token=${cloudflare_tunnel_token}

# LXC container defaults
lxc_root_password=${lxc_root_password}
lxc_ssh_public_key=${lxc_ssh_public_key}

# Direct container access for post-configuration
[cloudflared_host]
cloudflared ansible_host=${cloudflared_ip}

[cloudflared_host:vars]
ansible_user=root
ansible_password=${lxc_root_password}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# LXC Containers - Direct access for system updates
[lxc_containers]
bind9 ansible_host=${bind9_ip}
postgres ansible_host=${postgres_ip}
gitea ansible_host=${gitea_ip}
cloudflared_update ansible_host=${cloudflared_ip}

[lxc_containers:children]
ssh_containers

# Plain Debian 13 containers, configured directly over SSH with the root key OpenTofu injects
[librespeed_host]
librespeed ansible_host=${librespeed_ip}

[pulse_host]
pulse ansible_host=${pulse_ip}

[pulse_host:vars]
pulse_admin_password=${pulse_admin_password}
pulse_api_token=${pulse_api_token}
pulse_pve_token_id=${pulse_pve_token_id}
pulse_pve_token_secret=${pulse_pve_token_secret}

[ssh_containers:children]
librespeed_host
pulse_host

[ssh_containers:vars]
ansible_user=root
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[lxc_containers:vars]
ansible_user=root
ansible_password=${lxc_root_password}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# K3s Cluster VMs
[k3s_control]
%{ for vm in k3s_vms ~}
%{ if vm.role == "control" ~}
${vm.name} ansible_host=${vm.ip_address}
%{ endif ~}
%{ endfor ~}

[k3s_workers]
%{ for vm in k3s_vms ~}
%{ if vm.role == "worker" ~}
${vm.name} ansible_host=${vm.ip_address}
%{ endif ~}
%{ endfor ~}

[k3s_control:vars]
ansible_user=${vm_cloudinit_username}
ansible_password=${vm_cloudinit_password}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[k3s_workers:vars]
ansible_user=${vm_cloudinit_username}
ansible_password=${vm_cloudinit_password}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# K3s Raspberry Pis
[k3s_pis]
k3s-pi-01 ansible_host=${k3s_pi_01_ip}
k3s-pi-02 ansible_host=${k3s_pi_02_ip}

[k3s_pis:vars]
ansible_user=pi
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# K3s Cluster - All nodes (VMs + Pis)
[k3s_cluster:children]
k3s_control
k3s_workers
k3s_pis

# Convenience groups for updating all Debian-based infrastructure
[debian_hosts:children]
proxmox
lxc_containers
k3s_cluster
