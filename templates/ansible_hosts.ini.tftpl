# This is an auto generated file, please use Terraform and do not make manual changes

[proxmox]
%{ for node, cfg in proxmox_nodes ~}
${node} ansible_host=${cfg.address}
%{ endfor ~}

[proxmox:vars]
ansible_user=${proxmox_ssh_user}
ansible_port=${proxmox_ssh_port}
pm_api_host=${proxmox_host}
# Postgres and Gitea first-boot passwords, used by the pct-based plays
postgres_admin_password=${postgres_admin_password}
gitea_db_password=${gitea_db_password}
gitea_admin_password=${gitea_admin_password}
gitea_admin_email=${gitea_admin_email}

# The Proxmox node holding each container that's configured with pct; its play runs there
[postgres_node]
${lxc_nodes.postgres}

[gitea_node]
${lxc_nodes.gitea}

# bind9 and cloudflared have a container on each node, so each container gets its own entry for its node
[bind9_node]
%{ for key, ct in bind9_containers ~}
${lxc_nodes[key]}-ct${ct.vm_id} ansible_host=${proxmox_nodes[lxc_nodes[key]].address} bind9_ctid=${ct.vm_id} bind9_ip=${ct.ip_address}
%{ endfor ~}

[cloudflared_node]
%{ for key, ct in cloudflared_containers ~}
${lxc_nodes[key]}-ct${ct.vm_id} ansible_host=${proxmox_nodes[lxc_nodes[key]].address} cloudflared_ctid=${ct.vm_id} cloudflared_ip=${ct.ip_address}
%{ endfor ~}

# Same SSH login as [proxmox:vars]
[pct_container_nodes:children]
bind9_node
cloudflared_node

[pct_container_nodes:vars]
ansible_user=${proxmox_ssh_user}
ansible_port=${proxmox_ssh_port}

# Shared variables available to all hosts
[all:vars]
# Container IDs for pct operations
postgres_ctid=${postgres_ctid}
postgres_ip=${postgres_ip}

gitea_ctid=${gitea_ctid}
gitea_ip=${gitea_ip}

bind9_records=${bind9_records}
bind9_ips=${bind9_ips}
bind9_vip=${bind9_vip}

# Cloudflare Tunnel
cloudflare_tunnel_id=${cloudflare_tunnel_id}
cloudflare_tunnel_token=${cloudflare_tunnel_token}

# Slack webhook for lab alerts
slack_alerting_webhook=${slack_alerting_webhook}

# LXC container defaults
lxc_root_password=${lxc_root_password}
lxc_ssh_public_key=${lxc_ssh_public_key}

# Direct container access for post-configuration (root over SSH, from [lxc_containers:vars])
[bind9_host]
%{ for key, ct in bind9_containers ~}
${ct.name} ansible_host=${ct.ip_address}
%{ endfor ~}

[cloudflared_host]
%{ for key, ct in cloudflared_containers ~}
${ct.name} ansible_host=${ct.ip_address}
%{ endfor ~}

[cloudflared_host:vars]
ansible_user=root
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# LXC Containers - Direct access for system updates
[lxc_containers]
%{ for key, ct in bind9_containers ~}
${ct.name} ansible_host=${ct.ip_address}
%{ endfor ~}
postgres ansible_host=${postgres_ip}
gitea ansible_host=${gitea_ip}
%{ for key, ct in cloudflared_containers ~}
${ct.name}_update ansible_host=${ct.ip_address}
%{ endfor ~}

[lxc_containers:children]
ssh_containers

# Plain Debian 13 containers, configured directly over SSH with the root key OpenTofu injects
[librespeed_host]
librespeed ansible_host=${librespeed_ip}

[pulse_host]
pulse ansible_host=${pulse_ip}

[pulse_host:vars]
pulse_admin_password=${pulse_admin_password}
pulse_api_token=${pulse_api_token}
pulse_pve_token_id=${pulse_pve_token_id}
pulse_pve_token_secret=${pulse_pve_token_secret}

[ssh_containers:children]
librespeed_host
pulse_host

[ssh_containers:vars]
ansible_user=root
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[lxc_containers:vars]
ansible_user=root
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# K3s Cluster VMs
[k3s_control]
%{ for vm in k3s_vms ~}
%{ if vm.role == "control" ~}
${vm.name} ansible_host=${vm.ip_address}
%{ endif ~}
%{ endfor ~}

[k3s_workers]
%{ for vm in k3s_vms ~}
%{ if vm.role == "worker" ~}
${vm.name} ansible_host=${vm.ip_address}
%{ endif ~}
%{ endfor ~}

[k3s_control:vars]
ansible_user=${vm_cloudinit_username}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[k3s_workers:vars]
ansible_user=${vm_cloudinit_username}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# K3s Raspberry Pis
[k3s_pis]
pi-control ansible_host=${k3s_pi_01_ip}
pi-worker ansible_host=${k3s_pi_02_ip}

[k3s_pis:vars]
ansible_user=pi
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# K3s Cluster - All nodes (VMs + Pis)
[k3s_cluster:children]
k3s_control
k3s_workers
k3s_pis

# k3s-ansible groups (k3s.yaml): the first server initialises etcd and is the API endpoint
[server]
%{ for vm in k3s_vms ~}
%{ if vm.role == "control" ~}
${vm.name}
%{ endif ~}
%{ endfor ~}
pi-control

# Written to the Grafana admin Secret by k3s.yaml from the first server
[server:vars]
grafana_admin_password=${grafana_admin_password}

[agent]
%{ for vm in k3s_vms ~}
%{ if vm.role == "worker" ~}
${vm.name}
%{ endif ~}
%{ endfor ~}
pi-worker

# Convenience groups for updating all Debian-based infrastructure
[debian_hosts:children]
proxmox
lxc_containers
k3s_cluster
